{
  "manifest_version": 3,
  "name": "Sổ tài khoản QR chuyển khoản",
  "short_name": "Sổ TK QR",
  "version": "1.2.5",
  "description": "Quản lý số tài khoản ngân hàng, tạo mã VietQR chuyển khoản offline với gợi ý số tiền và nội dung, tìm kiếm và lọc theo nhóm.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sổ tài khoản QR chuyển khoản",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "alarms",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Mở Sổ tài khoản QR chuyển khoản"
    }
  },
  "optional_host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://www.googleapis.com/*",
    "https://api.vietqr.io/*",
    "https://img.vietqr.io/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
